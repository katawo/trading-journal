# Copy to deploy/.env and fill in. deploy/.env is gitignored and .dockerignored.
#
# Signs the multi-user "stay logged in" cookie. MUST be a long random secret and
# stable across restarts. Generate one with:
#   openssl rand -hex 32
# If unset, the web service refuses to start (docker-compose uses `:?`).
TRADING_JOURNAL_MULTIUSER_COOKIE_KEY=
